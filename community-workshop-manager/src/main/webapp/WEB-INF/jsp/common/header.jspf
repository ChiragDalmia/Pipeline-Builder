<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}"/> | Community Workshop Manager</title>
    <link rel="icon" href="data:,">
    <link rel="stylesheet" href="<c:url value='/css/site.css'/>">
</head>
<body>
<a class="skip-link" href="#main">Skip to main content</a>
<header class="site-header">
    <div class="container header-inner">
        <a class="brand" href="<c:url value='/overview'/>">Community Workshop Manager</a>
        <nav aria-label="Main">
            <ul class="nav">
                <li><a href="<c:url value='/overview'/>" <c:if test="${activeNav == 'overview'}">aria-current="page"</c:if>>Schedule overview</a></li>
                <li><a href="<c:url value='/workshops'/>" <c:if test="${activeNav == 'workshops'}">aria-current="page"</c:if>>Workshops</a></li>
                <li><a href="<c:url value='/instructors'/>" <c:if test="${activeNav == 'instructors'}">aria-current="page"</c:if>>Instructors</a></li>
            </ul>
        </nav>
    </div>
</header>
<main id="main" class="container">
<c:if test="${not empty successMessage}">
    <div class="alert alert-success" role="status"><c:out value="${successMessage}"/></div>
</c:if>
